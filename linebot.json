                "functionCode": "\nconst input = $input.item.json;\nconst text = input.chatInput || \"\";\nconst userId = input.userId;\n\n// Mock data if Sheet read fails or is empty\nlet currentWeight = input.weight || 0;\nlet currentHeight = input.height || 0;\n\n// Simple Regex\nconst weightMatch = text.match(/\u9ad4\u91cd\\s*[:=]?\\s*(\\d+(\\.\\d+)?)/i) || text.match(/(\\d+(\\.\\d+)?)kg/i);\nconst heightMatch = text.match(/\u8eab\u9ad8\\s*[:=]?\\s*(\\d+(\\.\\d+)?)/i) || text.match(/(\\d+(\\.\\d+)?)cm/i);\n\nlet updateNeeded = false;\n\nif (weightMatch) {\n  currentWeight = parseFloat(weightMatch[1]);\n  updateNeeded = true;\n}\nif (heightMatch) {\n  currentHeight = parseFloat(heightMatch[1]);\n  updateNeeded = true;\n}\n\n// Calculate BMI\nlet bmi = 0;\nif (currentWeight > 0 && currentHeight > 0) {\n  const h = currentHeight / 100;\n  bmi = (currentWeight / (h * h)).toFixed(1);\n}\n\nconst userProfile = `ID: ${userId}, \u9ad4\u91cd: ${currentWeight}kg, \u8eab\u9ad8: ${currentHeight}cm, BMI: ${bmi}`;\nconst chatInputWithContext = `\u3010\u4f7f\u7528\u8005\u5065\u5eb7\u8cc7\u6599\u3011\\n${userProfile}\\n\\n\u3010\u4f7f\u7528\u8005\u554f\u984c\u3011\\n${text}`;\n\nreturn {\n  json: {\n    ...input,\n    weight: currentWeight,\n    height: currentHeight,\n    bmi: bmi,\n    userProfile: userProfile,\n    updateNeeded: updateNeeded,\n    chatInput: chatInputWithContext\n  }\n};\n"
            },
