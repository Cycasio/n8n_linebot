            "parameters": {
                "functionCode": "\nconst input = $input.item.json;\nconst text = input.chatInput || \"\";\nconst userId = input.userId;\n\n// Mock data if Sheet read fails or is empty\nlet currentWeight = input.weight || 0;\nlet currentHeight = input.height || 0;\n\n// Simple Regex\nconst weightMatch = text.match(/體重\\s*[:=]?\\s*(\\d+(\\.\\d+)?)/i) || text.match(/(\\d+(\\.\\d+)?)kg/i);\nconst heightMatch = text.match(/身高\\s*[:=]?\\s*(\\d+(\\.\\d+)?)/i) || text.match(/(\\d+(\\.\\d+)?)cm/i);\n\nlet updateNeeded = false;\n\nif (weightMatch) {\n  currentWeight = parseFloat(weightMatch[1]);\n  updateNeeded = true;\n}\nif (heightMatch) {\n  currentHeight = parseFloat(heightMatch[1]);\n  updateNeeded = true;\n}\n\n// Calculate BMI\nlet bmi = 0;\nif (currentWeight > 0 && currentHeight > 0) {\n  const h = currentHeight / 100;\n  bmi = (currentWeight / (h * h)).toFixed(1);\n}\n\nconst userProfile = `ID: ${userId}, 體重: ${currentWeight}kg, 身高: ${currentHeight}cm, BMI: ${bmi}`;\nconst chatInputWithContext = `【使用者健康資料】\\n${userProfile}\\n\\n【使用者問題】\\n${text}`;\n\nreturn {\n  json: {\n    ...input,\n    weight: currentWeight,\n    height: currentHeight,\n    bmi: bmi,\n    userProfile: userProfile,\n    updateNeeded: updateNeeded,\n    chatInput: chatInputWithContext\n  }\n};\n"
            },
