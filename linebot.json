        {
            "parameters": {
                "functionCode": "\nlet inputData = $input.item;\nlet replyToken = '';\nlet chatInput = '';\nlet userId = '';\n\ntry {\n  const event = inputData.json?.body?.events?.[0];\n  if (event) {\n    replyToken = event.replyToken;\n    chatInput = event.message?.text || '';\n    userId = event.source?.userId || '';\n  } else {\n    return [{ json: { error: 'Invalid input structure' } }]; \n  }\n} catch (error) {\n  return [{ json: { error: 'Error processing input data', details: error.message } }]; \n}\nreturn [{ json: { replyToken, chatInput, userId } }];\n"
            },
