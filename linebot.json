        {
            "parameters": {
                "functionCode": "// \u8b93 Function \u7bc0\u9ede\u8f38\u5165\nlet inputData = $input.item;\n\nlet aiResponse = '';\nconst defaultResponse = '\u60a8\u597d\uff0c\u6211\u662f\u9673\u6631\u5f70\u91ab\u5e2bAI\u52a9\u624b\u3002\u8acb\u554f\u6709\u4ec0\u9ebc\u6211\u53ef\u4ee5\u5e6b\u52a9\u60a8\u7684\uff1f';\nconst errorResponse = '\u7cfb\u7d71\u8655\u7406\u51fa\u932f\uff0c\u8acb\u7a0d\u5f8c\u518d\u8a66\u3002';\nlet replyToken = '';\n\n/** 1) \u5148\u5b89\u5168\u6293 replyToken\uff1a\u512a\u5148\u53d6 Prepare Data\uff1b\u6c92\u6709\u5c31\u9000\u56de Webhook */\ntry {\n  replyToken = $node[\"Prepare Data\"]?.json?.replyToken\n            || $('Line Webhook').item.json?.body?.events?.[0]?.replyToken\n            || '';\n} catch (err) {\n  replyToken = $('Line Webhook').item.json?.body?.events?.[0]?.replyToken || '';\n}\n\n/** 2) \u63d0\u53d6 AI \u56de\u61c9\uff1a\u517c\u5bb9 OpenAI1(Assistants) \u8207 Agent(Image Router) \u7684\u591a\u7a2e\u8f38\u51fa\u9375 */\ntry {\n  const responseData = inputData.json;\n\n  // \u5e38\u898b\u65bc LangChain Agent \u7684\u8f38\u51fa\n  if (typeof responseData.output === 'string' && responseData.output.trim()) {\n    aiResponse = responseData.output.trim();\n  // \u6709\u4e9b\u7bc0\u9ede\u7528 text / answer \u7576\u9375\n  } else if (typeof responseData.text === 'string' && responseData.text.trim()) {\n    aiResponse = responseData.text.trim();\n  } else if (typeof responseData.answer === 'string' && responseData.answer.trim()) {\n    aiResponse = responseData.answer.trim();\n  }\n   else if (typeof responseData.message?.content === 'string' && responseData.message?.content.trim()) {\n             aiResponse = responseData.message?.content.trim();\n         }\n\n  if (!aiResponse) aiResponse = defaultResponse;\n  if (aiResponse.length > 5000) aiResponse = aiResponse.substring(0, 4997) + '...';\n\n} catch (error) {\n  aiResponse = errorResponse;\n}\n\n/** 3) \u4e00\u5b9a\u8981\u56de\u50b3\u9663\u5217\uff01 */\nreturn [\n  { json: { aiResponse, replyToken, encouragingImage: inputData.json.encouragingImage } }\n];\n"
            },
