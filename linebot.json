        {
            "parameters": {
                "functionCode": "// 讓 Function 節點輸入\nlet inputData = $input.item;\n\nlet aiResponse = '';\nconst defaultResponse = '您好，我是陳昱彰醫師AI助手。請問有什麼我可以幫助您的？';\nconst errorResponse = '系統處理出錯，請稍後再試。';\nlet replyToken = '';\n\n/** 1) 先安全抓 replyToken：優先取 Prepare Data；沒有就退回 Webhook */\ntry {\n  replyToken = $node[\"Prepare Data\"]?.json?.replyToken\n            || $('Line Webhook').item.json?.body?.events?.[0]?.replyToken\n            || '';\n} catch (err) {\n  replyToken = $('Line Webhook').item.json?.body?.events?.[0]?.replyToken || '';\n}\n\n/** 2) 提取 AI 回應：兼容 OpenAI1(Assistants) 與 Agent(Image Router) 的多種輸出鍵 */\ntry {\n  const responseData = inputData.json || {};\n\n  const stringCandidates = [\n    responseData.output,\n    responseData.text,\n    responseData.answer,\n    responseData.response,\n    responseData.result,\n    responseData.results?.[0],\n    responseData.message?.content,\n    responseData.data?.[0]?.text,\n    responseData.choices?.[0]?.message?.content,\n    responseData.choices?.[0]?.text,\n  ];\n\n  for (const candidate of stringCandidates) {\n    if (typeof candidate === 'string' && candidate.trim()) {\n      aiResponse = candidate.trim();\n      break;\n    }\n  }\n\n  if (!aiResponse) aiResponse = defaultResponse;\n  if (aiResponse.length > 5000) aiResponse = aiResponse.substring(0, 4997) + '...';\n\n} catch (error) {\n  aiResponse = errorResponse;\n}\n\n/** 3) 一定要回傳陣列！ */\nreturn [\n  { json: { aiResponse, replyToken, encouragingImage: inputData.json?.encouragingImage } }\n];"
            },
